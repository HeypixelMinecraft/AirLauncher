.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
# Rust 构建产物（1GB+，绝不能进仓库）
/src-tauri/target
# 打包出来的安装包
/src-tauri/target/release/bundle
# 早期调研用的临时样本（forge installer / jre zip / 参考源码）
/.spike
# 构建日志（含本机路径，不入库）
*.log
# 统一用 pnpm，忽略 npm 生成的锁文件
/package-lock.json
# 启动器运行时数据（实例、缓存、用户设置），不入库
/instances
/cache
/settings.json
